SARVAM_API_KEY=your_api_key_here
JWT_SECRET=
GOOGLE_CLIENT_IDS=
PUBLIC_API_URL=http://127.0.0.1:8000
ADMIN_EMAILS=
CORS_ORIGINS=

# Observability
# LangSmith traces (off unless LANGSMITH_TRACING=true and a key is set). By default prompts and replies are NOT sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sahaj
LANGSMITH_HIDE_IO=true
ENVIRONMENT=development
# When set, /metrics needs "Authorization: Bearer <token>"
METRICS_TOKEN=
LOG_FORMAT=text

# API gateway layer (limits are per client address, per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_WS_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=300
MAX_BODY_BYTES=31457280
# true only when a proxy or load balancer sits in front and sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# File storage (Amazon S3). Uploads are disabled until AWS_S3_BUCKET is set.
# Credentials are not set here: boto3 finds them itself (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, an AWS_PROFILE or SSO
# login, or the IAM role of the server, which is what you want in production). Policy: infra/aws/iam-policy.json.
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-2
# AWS_PROFILE=
# Or explicit keys of an IAM user (not recommended on a server):
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Only for local development with MinIO (docker compose --profile storage up -d):
# AWS_ENDPOINT_URL=http://localhost:9000
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_USER=50

# Local testing: a sign-in with no Google account (only when ENVIRONMENT=development and the caller is this machine),
# and the test console at http://127.0.0.1:8000/test/
DEV_LOGIN=false
TEST_PAGE=true
# Fill the knowledge base from knowledge/ when the API starts (only new or changed clauses are embedded)
AUTO_INGEST=true
# Asking questions about uploaded PDFs
DOC_MAX_PAGES=60
DOC_MAX_CHUNKS=200
DOC_CHUNK_CHARS=900

# Which model answers: voice conversations use Sarvam end to end; typed ones use OpenAI.
# OPENAI_API_KEY is also needed for the knowledge-base embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
TEXT_LLM_PROVIDER=openai
VOICE_LLM_PROVIDER=sarvam
# Embeddings for the knowledge base (changing either rebuilds it on the next start)
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
OPENAI_EMBED_PRICE_PER_M=0.02
RETRIEVAL_MIN_SIMILARITY=0.30

# Prices in USD, used to estimate what each person spends. ESTIMATES: check them against your invoices.
OPENAI_PRICE_IN_PER_M=0.15
OPENAI_PRICE_CACHED_PER_M=0.075
OPENAI_PRICE_OUT_PER_M=0.60
SARVAM_LLM_PRICE_IN_PER_M=0.25
SARVAM_LLM_PRICE_CACHED_PER_M=0.125
SARVAM_LLM_PRICE_OUT_PER_M=0.75
SARVAM_STT_PRICE_PER_HOUR=0.35
SARVAM_TTS_PRICE_PER_10K_CHARS=0.18
STT_BYTES_PER_SECOND=4000

# Spending limit per person per calendar month (UTC). An admin can set a different one per person.
BUDGET_ENABLED=true
USER_BUDGET_USD=5
BUDGET_WARN_AT=0.8

# Customer executive desk: how soon a case should be picked up, by priority (minutes)
DESK_SLA_URGENT_MINUTES=5
DESK_SLA_HIGH_MINUTES=30
DESK_SLA_NORMAL_MINUTES=120
# Clarifying questions in a row before a person is brought in
LOW_CONFIDENCE_HANDOFF_AFTER=2

# Live India insurance web search via Firecrawl (optional). Search usage cost is an estimate you can configure.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT_SECONDS=45
FIRECRAWL_SEARCH_LIMIT=5
FIRECRAWL_PRICE_PER_CREDIT_USD=0

# Optional installed partner adapters; each module exports register(register_provider).
FINANCIAL_PROVIDER_MODULES=

# OCR for scanned PDFs and photos: Sarvam Document AI (Parse). Text PDFs are read locally, for free.
SARVAM_OCR_PRICE_PER_PAGE=0.006
OCR_TIMEOUT_SECONDS=180
