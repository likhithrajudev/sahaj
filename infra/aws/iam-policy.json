{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SahajListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::paytm-sahaj"
    },
    {
      "Sid": "SahajUserFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::paytm-sahaj/users/*"
    }
  ]
}
