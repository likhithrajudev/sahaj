      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sahaj-prometheus"
          },
          "expr": "sum(rate(sahaj_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(sahaj_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
